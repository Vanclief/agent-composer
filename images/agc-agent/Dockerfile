FROM node:22-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends \
    git tmux curl ca-certificates openssh-client jq ripgrep less procps vim-tiny make \
    && rm -rf /var/lib/apt/lists/*
# GitHub CLI from GitHub's apt repository (https://cli.github.com/packages).
# No login: gh reads GITHUB_TOKEN from the environment when a task binds it.
RUN mkdir -p -m 755 /etc/apt/keyrings \
    && curl -fsSL -o /etc/apt/keyrings/githubcli-archive-keyring.gpg \
         https://cli.github.com/packages/githubcli-archive-keyring.gpg \
    && chmod go+r /etc/apt/keyrings/githubcli-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
         > /etc/apt/sources.list.d/github-cli.list \
    && apt-get update && apt-get install -y --no-install-recommends gh \
    && rm -rf /var/lib/apt/lists/*
RUN npm install -g @anthropic-ai/claude-code @openai/codex

# Go toolchain, matching the go directive in go.mod (build.sh checks they
# agree). Official tarball, verified against the sha256 published on
# https://go.dev/dl/. Bump GO_VERSION and both sums together.
ARG GO_VERSION=1.26.1
ARG GO_SHA256_AMD64=031f088e5d955bab8657ede27ad4e3bc5b7c1ba281f05f245bcc304f327c987a
ARG GO_SHA256_ARM64=a290581cfe4fe28ddd737dde3095f3dbeb7f2e4065cab4eae44dfc53b760c2f7
RUN arch="$(dpkg --print-architecture)" \
    && case "$arch" in \
         amd64) sum="$GO_SHA256_AMD64" ;; \
         arm64) sum="$GO_SHA256_ARM64" ;; \
         *) echo "no Go tarball pinned for $arch" >&2 && exit 1 ;; \
       esac \
    && curl -fsSL -o /tmp/go.tgz "https://go.dev/dl/go${GO_VERSION}.linux-${arch}.tar.gz" \
    && echo "$sum  /tmp/go.tgz" | sha256sum -c - \
    && tar -C /usr/local -xzf /tmp/go.tgz \
    && rm /tmp/go.tgz
ENV GOPATH=/home/agent/go
ENV PATH=/usr/local/go/bin:/home/agent/go/bin:$PATH
# Login shells (tmux, bash -l) get PATH reset by /etc/profile; put Go back.
RUN echo 'export PATH=/usr/local/go/bin:/home/agent/go/bin:$PATH' > /etc/profile.d/go.sh

# System libraries Playwright's Chromium needs, for the panel's tests. The
# browser itself is not baked in: agents run `npx playwright install chromium`
# in panel/ (make panel-check does it). Keep the version equal to
# @playwright/test in panel/package.json.
ARG PLAYWRIGHT_VERSION=1.64.1
RUN npx -y "playwright@${PLAYWRIGHT_VERSION}" install-deps chromium \
    && rm -rf /var/lib/apt/lists/* /root/.npm

RUN useradd -m -s /bin/bash agent
# Both are generated by build.sh: the agc binary (for agc msg) and the
# messaging readme agents are pointed at (ADR 0005).
COPY agc /usr/local/bin/agc
COPY README.guest.md /etc/agc/README.md
# System-wide, not in ~/.gitconfig: agc mounts a fresh disk on /home/agent
# (ADR 0008, "Disk and transcripts"), which hides the image's home.
# $GITHUB_TOKEN is escaped so the helper reads it when git asks, not at build time.
RUN git config --system credential.helper "!f() { echo username=x-access-token; echo password=\$GITHUB_TOKEN; }; f"
USER agent
WORKDIR /home/agent
ENV TERM=xterm-256color
CMD ["sleep", "infinity"]
